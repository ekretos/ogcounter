#!/usr/bin/env bash
set -Eeuo pipefail

SERVER_DIR="${SERVER_DIR:-/home/container}"
BOX64="${BOX64_BIN:-/usr/local/bin/box64}"

if [[ ! -x "$BOX64" ]]; then
  echo "[ogcounter] ERROR: Box64 is missing: $BOX64" >&2
  exit 1
fi

if [[ ! -x "$SERVER_DIR/hlds_linux" || ! -d "$SERVER_DIR/cstrike" ]]; then
  echo "[ogcounter] ERROR: HLDS or cstrike files are missing. Run the Pterodactyl installer first." >&2
  exit 1
fi

cd "$SERVER_DIR"
ARGS=(
  -game cstrike
  -console
  -port "${SERVER_PORT:-27015}"
  +ip 0.0.0.0
  +map "${SERVER_MAP:-de_dust2}"
  +maxplayers "${MAX_PLAYERS:-16}"
)

if [[ -n "${SERVER_PASSWORD:-}" ]]; then
  ARGS+=(+sv_password "$SERVER_PASSWORD")
fi
if [[ -n "${RCON_PASSWORD:-}" ]]; then
  ARGS+=(+rcon_password "$RCON_PASSWORD")
fi

echo "[ogcounter] Starting HLDS via Box64/Box32."
exec "$BOX64" ./hlds_linux "${ARGS[@]}"
